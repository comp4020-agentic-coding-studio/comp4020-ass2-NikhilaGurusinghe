node_modules/
dist/
*.log

# Next's build intermediates and generated types. The exported site itself
# lands in dist/ (see distDir in next.config.ts), ignored above.
.next/
next-env.d.ts
*.tsbuildinfo

# Local-only capture from the last Astro build: compiled brand CSS, rendered
# HTML and the Slop logo assets, kept so the visual system can be rebuilt
# faithfully once the Astro packages are uninstalled. Not part of the
# deliverable; the committed reference is spec/fixtures/golden-api/.
.astro-reference/

# staging dir for the CI link check
linkcheck/

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Claude Code's project directory is machine-local: settings in here can hold
# your course API key, and this repo goes public when you ship. Your tracked
# harness is CLAUDE.md (and any AGENTS.md), not this directory.
.claude/
