{
  "name": "slop-university-course-site",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "next dev",
    "build": "bun scripts/check-refs.ts && next build && bun scripts/emit-course-api.ts && bunx pagefind --site dist && bun scripts/check-links.ts && bun scripts/check-a11y.ts",
    "preview": "bunx serve dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun run test",
    "check:evidence": "node scripts/check-evidence.ts",
    "check:links": "bun scripts/check-links.ts",
    "check:a11y": "bun scripts/check-a11y.ts",
    "test": "bun run build && bun test spec",
    "test:template": "bun test scripts lib"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.10.3",
    "jsdom": "^26.1.0",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "@biomejs/biome",
    "pagefind"
  ]
}
