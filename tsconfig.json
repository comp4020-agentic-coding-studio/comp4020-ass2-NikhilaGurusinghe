{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // scripts/ and spec/ import each other with explicit .ts extensions, which
    // is what Bun and Node's type-stripping both want. Safe here because
    // nothing in this project is emitted by tsc.
    "allowImportingTsExtensions": true,
    // Not just tidiness: Next's generated .next/types/validator.ts guards each
    // route export with a `@ts-expect-error` that only fires when this is on.
    // Leave it off and `tsc --noEmit` fails on the framework's own codegen with
    // "Unused '@ts-expect-error' directive".
    "noUnusedLocals": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".astro-reference"]
}
