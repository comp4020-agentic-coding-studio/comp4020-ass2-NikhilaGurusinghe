---
import ContentLayout, {
  type ContentLayoutProps,
} from "astro-theme-university/layouts/ContentLayout.astro";
import { siteConfig } from "../site-config";

interface Props {
  frontmatter?: ContentLayoutProps;
}

const { frontmatter, ...direct } = Astro.props;
const { heroTitle, ...props } = (frontmatter ?? direct) as ContentLayoutProps & {
  heroTitle?: string;
};
---

<ContentLayout {...siteConfig} {...props}>
  <slot />
</ContentLayout>
